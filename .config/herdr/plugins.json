  {
    "plugin_id": "ray.plugin-manager",
    "name": "Plugin Manager",
    "version": "0.5.0",
    "min_herdr_version": "0.7.4",
    "description": "Manage herdr plugins from a popup: list, install, update, enable/disable, uninstall, browse the marketplace, open repo in browser, edit plugins.json",
    "manifest_path": "/Users/sergi/.config/herdr/plugins/github/ray.plugin-manager-75f462e8e1d0/herdr-plugin.toml",
    "plugin_root": "/Users/sergi/.config/herdr/plugins/github/ray.plugin-manager-75f462e8e1d0",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "actions": [
      {
        "id": "open",
        "title": "Open plugin manager",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "exec \"${HERDR_BIN_PATH:-herdr}\" plugin pane open --plugin ray.plugin-manager --entrypoint manager --placement popup --focus"
        ]
      }
    ],
    "panes": [
      {
        "id": "manager",
        "title": "Plugin Manager",
        "placement": "popup",
        "width": 82,
        "height": 28,
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/manager.sh\""
        ]
      }
    ],
    "source": {
      "kind": "github",
